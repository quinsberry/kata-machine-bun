{
    "name": "kata",
    "version": "1.0.0",
    "main": "index.js",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "format": "prettier --write ./src",
        "lint": "bun run tsc --noEmit",
        "generate": "bun run ./scripts/generate.ts",
        "cli": "bun run ./scripts/cli.ts",
        "clear": "bun run ./scripts/clear.ts",
        "format:day": "prettier --write --ignore-path .prettierignore ./src/day1",
        "day": "echo src/day1",
        "test": "bun run ./scripts/test.ts"
    },
    "devDependencies": {
        "@inquirer/prompts": "^8.7.3",
        "@types/bun": "^1.4.3",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    }
}