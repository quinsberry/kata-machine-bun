{
    "name": "kata",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "dependencies": {
        "@inquirer/prompts": "^7.2.3",
        "@types/bun": "^1.1.17",
        "prettier": "^3.4.2",
        "typescript": "^5.7.3"
    },
    "scripts": {
        "prettier": "prettier --write ./src",
        "generate": "bun run ./scripts/generate.ts",
        "cli": "bun run ./scripts/cli.ts",
        "clear": "bun run ./scripts/clear.ts",
        "format:day": "prettier --write --ignore-path .prettierignore ./src/day1",
        "day": "echo src/day1"
    }
}